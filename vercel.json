{
  "headers": [
    {
      "source": "/downloads/(.*)\\.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!downloads/.*|assets/.*).*)",
      "destination": "/index.html"
    }
  ]
}
